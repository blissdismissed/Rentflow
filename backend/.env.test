NODE_ENV=test

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentflow_test
DB_USER=rentflow-user
DB_PASSWORD=

# JWT
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_REFRESH_SECRET=test-jwt-refresh-secret-for-testing

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_PUBLISHABLE_KEY=pk_test_mock

# SendGrid
SENDGRID_API_KEY=SG.test_key
SENDGRID_FROM_EMAIL=test@example.com

# AWS
AWS_ACCESS_KEY_ID=test_access_key
AWS_SECRET_ACCESS_KEY=test_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=test-bucket

# URLs
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:8000

# Rate limiting (disable during tests to prevent hitting the 100 req/15min cap)
RATE_LIMIT_MAX_REQUESTS=100000

# Google OAuth (dummy values — OAuth routes are not tested)
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
